+export const FPS=24;
+export const STATES=Object.freeze([{"state": 90, "start": 90, "end": 95, "url": "/assets/chars/s29/F090.png", "sha256": "677060fef631583bb0fdce04572305c868af6d397e7c44b80e7e4b2483a620b8"}, {"state": 96, "start": 96, "end": 101, "url": "/assets/chars/s29/F096.png", "sha256": "eae8b4abdc72cf0926ec77b5bf8d726b105b55244062fac1b81c4feaefb91bf4"}, {"state": 102, "start": 102, "end": 107, "url": "/assets/chars/s29/F102.png", "sha256": "41ecc6f85b12a8c34dd479597ce552da57dca75bd86b0676941888f72f42065f"}, {"state": 108, "start": 108, "end": 115, "url": "/assets/chars/s29/F108.png", "sha256": "b6ecab7c1ea371b62e15a3dd4e6f1f360173b3ddfa2e496f5f28e7122bc76c02"}].map(Object.freeze));
+export function resolveFrame(f){const row=Number.isInteger(f)&&STATES.find(r=>f>=r.start&&f<=r.end);if(!row)throw new RangeError("Only S29 F090–115 allowed");return row;}
